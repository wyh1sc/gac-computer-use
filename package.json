{
  "name": "gac-computer-use",
  "version": "1.0.0",
  "description": "面向 Windows 的 Computer Use（GUI 自动化）DSH 插件：自包含重实现 GAC 协议 v1 服务端 + MCP stdio 桥 + 实时 \"pip\" 隔离桌面预览，不随包分发任何第三方运行时。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "python",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "computer-use",
    "gui-automation",
    "windows",
    "mcp",
    "dsh",
    "agent"
  ],
  "license": "MIT"
}
